<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app keeps (its settings, the relay choice) goes into Google's cloud backup or to a
     new phone. Chats are never stored at all. Android 12 and later read this; older versions go by
     allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
